<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- ВАРІАНТ 1 (за замовчуванням): LocalDB, що встановлюється разом з Visual Studio -->
    <add name="CinemaHub" connectionString="Server=(localdb)\MSSQLLocalDB;Database=CinemaHub_DB;Trusted_Connection=True;" providerName="System.Data.SqlClient" />
    <!-- ВАРІАНТ 2: SQL Server Express - закоментуйте рядок вище і розкоментуйте цей:
    <add name="CinemaHub"
         connectionString="Server=.\SQLEXPRESS;Database=CinemaHub_DB;Trusted_Connection=True;"
         providerName="System.Data.SqlClient" />
    -->
    <!-- ВАРІАНТ 3: повний SQL Server на цьому ПК:
         Server=localhost;Database=CinemaHub_DB;Trusted_Connection=True; -->
  </connectionStrings>
</configuration>