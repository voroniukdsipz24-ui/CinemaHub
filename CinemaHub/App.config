<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
      <add name="CinemaHub" connectionString="Server=(localdb)\MSSQLLocalDB;Database=CinemaHub_DB;Trusted_Connection=True;"
          providerName="System.Data.SqlClient" />
      <add name="CinemaHub.Properties.Settings.CinemaHub_DBConnectionString"
          connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=CinemaHub_DB;Integrated Security=True;Encrypt=True"
          providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
